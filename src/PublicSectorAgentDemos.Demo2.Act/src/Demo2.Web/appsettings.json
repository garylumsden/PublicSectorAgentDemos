{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning",
      "Azure.AI.Projects": "Warning",
      "OpenAI": "Warning"
    }
  },
  "Demo2": {
    "RulesPath": "config/domain/flood-support-rules.v1.json",
    "ToolPolicyPath": "config/policies/demo2-tools.v1.json",
    "MaxComplaintCharacters": 6000,
    "ApprovalLifetimeMinutes": 30,
    "Agent": {
      "Mode": "LocalContract",
      "Name": "cross-government-flood-support",
      "ProjectEndpoint": "",
      "ModelDeploymentName": "",
      "MaxOutputTokens": 4000,
      "MaxToolCalls": 4
    },
    "Toolbox": {
      "Name": "flood-support",
      "Endpoint": "http://localhost:5100/mcp/flood-support",
      "DispatchToolName": "reserveSupportPackage"
    },
    "Persistence": {
      "Provider": "InMemory",
      "CosmosEndpoint": "",
      "DatabaseName": "defra-ai-demos",
      "ContainerName": "demo2-flood-support-cases"
    },
    "Audit": {
      "Path": "audit/demo2-audit.jsonl"
    }
  },
  "AllowedHosts": "*"
}
